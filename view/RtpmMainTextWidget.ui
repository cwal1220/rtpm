  <property name="styleSheet">
   <string notr="true">QWidget#Form {
    background-color: #2d2d2d;
}

QGroupBox {
    background-color: #424242; /* Slightly lighter */
    border: 1px solid #616161; /* Softer border */
    border-radius: 8px;
    margin-top: 10px;
    padding: 10px; /* Added padding */
    font-size: 11pt;
    color: #e0e0e0; /* Slightly softer text color */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
}

QLabel {
    color: #f0f0f0;
    font-size: 10pt;
}

QLabel[objectName$="ValueLabel"] { /* Targets labels ending with "ValueLabel" */
    font-size: 18pt; /* Reduced font size */
    font-weight: bold;
    color: #66BB6A; /* Softer green */
}

QPushButton {
    color: white;
    border-radius: 5px;
    padding: 8px 15px;
    font-weight: bold;
    font-size: 10pt;
}

QPushButton#startButton {
    background-color: #4CAF50; /* Green */
}

QPushButton#startButton:hover {
    background-color: #5cb85c;
}

QPushButton#startButton:disabled {
    background-color: #444;
}

QPushButton#stopButton {
    background-color: #d9534f; /* Red */
}

QPushButton#stopButton:hover {
    background-color: #c9302c;
}

QPushButton#stopButton:disabled {
    background-color: #444;
}

QPushButton#fileSelectButton {
    background-color: #5bc0de; /* Blue */
    padding: 5px;
}

QPushButton#fileSelectButton:hover {
    background-color: #46b8da;
}

QPushButton#togglePerformanceButton {
    background-color: #f0ad4e; /* Orange */
}

QPushButton#togglePerformanceButton:hover {
    background-color: #eea236;
}

QComboBox {
    background-color: #555;
    border: 1px solid #666;
    border-radius: 5px;
    padding: 5px;
    color: #f0f0f0;
}

QComboBox::drop-down {
    border: none;
}

QComboBox::down-arrow {
    image: url(:/icons/down_arrow.png); /* Add a custom down arrow icon if needed */
}

QProgressBar {
    border: 1px solid #555555;
    border-radius: 5px;
    text-align: center;
    background-color: #424242; /* Matching QGroupBox background */
    color: white;
    height: 15px; /* Slightly taller */
}

QProgressBar::chunk {
    background-color: #66BB6A; /* Softer green */
    border-radius: 5px;
}

QLineEdit {
    background-color: #555;
    border: 1px solid #666;
    border-radius: 5px;
    padding: 5px;
    color: #f0f0f0;
}

QCheckBox {
    color: #f0f0f0;
}
</string>
