# Git ignore patterns for the rtpm project

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
#*.pyd
#*.so

# Virtual environment
.venv/

# IDE and editor files
.vscode/
.vs/

# Build artifacts
build/
*.egg-info/
dist/
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage
.nox/

# OS generated files
.DS_Store
.Trashes
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp

# Test related files
test_files/
test_results/

# Specific build artifacts from refactoring
